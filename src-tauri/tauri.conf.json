{
  "productName": "MoPlayer",
  "version": "0.58.0",
  "identifier": "com.moplayer.desktop",
  "build": {
    "beforeBuildCommand": "npm run prebuild && npm run build && npm run build:music",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "MoPlayer",
        "width": 720,
        "height": 405,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Capability for the main window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:window:default",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-start-dragging",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-position",
            "core:window:allow-set-size",
            "core:window:allow-center",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:event:default",
            "core:event:allow-listen",
            "fs:default",
            "fs:allow-read-file",
            "fs:allow-read-dir",
            "fs:allow-exists",
            {
              "identifier": "fs:scope",
              "allow": [
                "**"
              ],
              "deny": []
            },
            "dialog:allow-message",
            "dialog:allow-open"
          ]
        }
      ]
    }
  },
  "plugins": {
    "dialog": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright © 2024 MoPlayer Team",
    "shortDescription": "高性能音视频播放器",
    "longDescription": "基于 Tauri + Rust/FFmpeg 架构的高性能小体积 Windows 桌面音视频播放器",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "zh-CN",
        "fragmentPaths": [
          "wix/ContextMenuFragment.wxs"
        ],
        "componentGroupRefs": [],
        "componentRefs": [
          "MoPlayerContextMenuComponent"
        ],
        "featureGroupRefs": [],
        "mergeRefs": []
      },
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "languages": [
          "SimpChinese"
        ],
        "customLanguageFiles": {
          "SimpChinese": "nsis-language-SimpChinese.nsh"
        },
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4"
        ],
        "description": "MP4 视频文件",
        "mimeType": "video/mp4"
      },
      {
        "ext": [
          "avi"
        ],
        "description": "AVI 视频文件",
        "mimeType": "video/avi"
      },
      {
        "ext": [
          "mkv"
        ],
        "description": "MKV 视频文件",
        "mimeType": "video/x-matroska"
      },
      {
        "ext": [
          "mov"
        ],
        "description": "MOV 视频文件",
        "mimeType": "video/quicktime"
      },
      {
        "ext": [
          "wmv"
        ],
        "description": "WMV 视频文件",
        "mimeType": "video/x-ms-wmv"
      },
      {
        "ext": [
          "flv"
        ],
        "description": "FLV 视频文件",
        "mimeType": "video/x-flv"
      },
      {
        "ext": [
          "webm"
        ],
        "description": "WebM 视频文件",
        "mimeType": "video/webm"
      },
      {
        "ext": [
          "m4v"
        ],
        "description": "M4V 视频文件",
        "mimeType": "video/x-m4v"
      },
      {
        "ext": [
          "3gp"
        ],
        "description": "3GP 视频文件",
        "mimeType": "video/3gpp"
      },
      {
        "ext": [
          "mp3"
        ],
        "description": "MP3 音频文件",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "wav"
        ],
        "description": "WAV 音频文件",
        "mimeType": "audio/wav"
      },
      {
        "ext": [
          "flac"
        ],
        "description": "FLAC 音频文件",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "aac"
        ],
        "description": "AAC 音频文件",
        "mimeType": "audio/aac"
      },
      {
        "ext": [
          "ogg"
        ],
        "description": "OGG 音频文件",
        "mimeType": "audio/ogg"
      },
      {
        "ext": [
          "wma"
        ],
        "description": "WMA 音频文件",
        "mimeType": "audio/x-ms-wma"
      },
      {
        "ext": [
          "m4a"
        ],
        "description": "M4A 音频文件",
        "mimeType": "audio/mp4"
      },
      {
        "ext": [
          "pdf"
        ],
        "description": "PDF 文档",
        "mimeType": "application/pdf"
      }
    ]
  }
}
