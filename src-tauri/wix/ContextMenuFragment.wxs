        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.rw2\shell\OpenWithMoPlayer\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" /></RegistryKey>
