        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.png\shell\OpenWithMoPlayer\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" /></RegistryKey>
