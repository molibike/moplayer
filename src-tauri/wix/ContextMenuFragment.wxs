        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.gif\shell\OpenWithMoPlayer\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" /></RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.bmp\shell\OpenWithMoPlayer"><RegistryValue Type="string" Value="用MoPlayer打开" /></RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.bmp\shell\OpenWithMoPlayer\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" /></RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.webp\shell\OpenWithMoPlayer"><RegistryValue Type="string" Value="用MoPlayer打开" /></RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.webp\shell\OpenWithMoPlayer\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" /></RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.ico\shell\OpenWithMoPlayer"><RegistryValue Type="string" Value="用MoPlayer打开" /></RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.ico\shell\OpenWithMoPlayer\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" /></RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.svg\shell\OpenWithMoPlayer"><RegistryValue Type="string" Value="用MoPlayer打开" /></RegistryKey>
