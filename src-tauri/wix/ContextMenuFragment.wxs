        </RegistryKey>

        <!-- 3gp锛堜笌 bundle.fileAssociations 淇濇寔涓€鑷达級 -->
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.3gp\shell\OpenWithMoPlayer">
          <RegistryValue Type="string" Value="用MoPlayer打开" />
