        <!-- ensure open-with launches moplayer -->
        <RegistryKey Root="HKCR" Key="Applications\moplayer.exe\shell\open\command"><RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" /></RegistryKey>

        <!-- OpenWithList entries for video formats -->
        <RegistryKey Root="HKCR" Key=".mp4\OpenWithList\moplayer.exe" />
        <RegistryKey Root="HKCR" Key=".avi\OpenWithList\moplayer.exe" />
        <RegistryKey Root="HKCR" Key=".mkv\OpenWithList\moplayer.exe" />
