<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- 娑撶儤澧嶉張澶嬫瀮娴犺埖鍧婇崝鐘插礁闁款喛褰嶉崡鏇窗娴ｈ法鏁?MoPlayer 閹垫挸绱?-->
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <!-- 娑撳搫鐖剁憴渚€鐓剁憴鍡涱暥缁鐎峰ǎ璇插閸欐娊鏁懣婊冨礋閿涙瓌pen with MoPlayer -->
      <Component Id="MoPlayerContextMenuComponent" Guid="*">
        <!-- mp4 -->
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.mp4\shell\OpenWithMoPlayer">
          <RegistryValue Type="string" Value="用MoPlayer打开" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.mp4\shell\OpenWithMoPlayer\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" KeyPath="yes" />
        </RegistryKey>

        <!-- avi -->
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.avi\shell\OpenWithMoPlayer">
          <RegistryValue Type="string" Value="用MoPlayer打开" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.avi\shell\OpenWithMoPlayer\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" />
        </RegistryKey>

        <!-- mkv -->
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.mkv\shell\OpenWithMoPlayer">
          <RegistryValue Type="string" Value="用MoPlayer打开" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.mkv\shell\OpenWithMoPlayer\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]moplayer.exe&quot; &quot;%1&quot;" />
        </RegistryKey>

